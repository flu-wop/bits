# Copy to .env.local for development. In production set these in Vercel > Settings > Environment Variables.
# Never commit real values: this repository is public.

# Database (Turso). Leave unset in development to use a local file at .data/bits.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin sign-in: exactly two addresses, comma separated
ADMIN_EMAILS=raquel@example.com,flu.wop@gmail.com
# Absolute site address used in sign-in links (no trailing slash)
SITE_URL=http://localhost:3000

# Email (Resend). Without these, development prints the sign-in link in the server console
RESEND_API_KEY=
MAIL_FROM="BITS <admin@breaksinthesimulation.com>"

# Stripe (BITS's own account). Test keys for Preview, live keys for Production only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared secret Vercel cron sends to /api/cron/release (any long random string)
CRON_SECRET=
# Vercel Blob store for gallery uploads (create a Blob store in the Vercel project)
BLOB_READ_WRITE_TOKEN=
