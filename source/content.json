    {
      "slug": "about-us",
      "path": "/about-us",
      "title": "about us",
      "section": "home",
      "backdrop": {
        "type": "gradient",
        "css": "radial-gradient(circle, rgb(14, 29, 239) 0%, rgb(14, 29, 239) 0%, rgb(0, 175, 89) 45.92%, rgb(0, 175, 89) 54.08%, rgb(2, 2, 14) 100%, rgb(2, 2, 14) 100%)"
      },
      "blocks": [
        {
          "type": "heading",
          "level": 1,
          "text": "Breaking the pattern. Building the artist.",
          "color": "#a4a5ab",
          "liveTag": "div (bold, <font>)"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "WHO ARE WE?",
          "color": "#0e1def",
          "liveTag": "span (bold)"
        },
        {
          "type": "paragraph",
          "text": "Breaks In The Simulation (BITS) is a purpose-driven creative agency specializing in artist development, wellness integration, and creative entrepreneurship. Founded by a passionate multidisciplinary artist, educator, music enthusiast, and mental health specialist, BITS is poised to create a transformative impact in creative industries by prioritizing the holistic development of artists. By integrating social-emotional learning into immersive experiences and developmental services, we foster a community where artists can find support, guidance, and inspiration towards sustainable success. We believe that the path to artistic excellence goes hand in hand with personal growth, skill development, and resilience.",
          "color": "#ffffff@0.9"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "WHAT DO WE DO?",
          "color": "#0e1def",
          "liveTag": "span (bold)"
        },
        {
          "type": "paragraph",
          "text": "Breaks In The Simulation develops artists and the ecosystems around them, combining creative strategy with wellness-centered practices to help both artists and organizations build sustainable, impactful futures.",
          "color": "#ffffff@0.9",
          "note": "live text is indented with 8 NBSP characters"
        },
        {
          "type": "paragraph",
          "text": "We use innovative event programming, hands-on artist development services, and tailored resources to provide music artists with the tools and knowledge necessary to navigate the complex landscape of the music industry, while safeguarding their mental and emotional well-being. Our offerings focus on elevating creative entrepreneurship, social-emotional intelligence, community support, and creative expression within a robust cultural ecosystem.",
          "color": "#ffffff@0.9"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "OUR MISSION",
          "color": "#0e1def",
          "liveTag": "span (bold)"
        },
        {
          "type": "paragraph",
          "text": "BITS redefines artist development with holistic infrastructure that merges creative craft, holistic wellness, community connection, and entrepreneurial education to build sustainable artist careers and culturally vibrant ecosystems.",
          "color": "#ffffff@0.9"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "OUR VISION",
          "color": "#0e1def",
          "liveTag": "span (bold)"
        },
        {
          "type": "paragraph",
          "text": "We envision a long-term legacy of healthier creative communities, richer cultural expressions, and artists who have the foundation to grow into industry leaders, mentors, and innovators.",
          "color": "#ffffff@0.9"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "CONTACT US",
          "color": "#0e1def",
          "liveTag": "span (bold)"
        },
        {
          "type": "paragraph",
          "text": "EMAIL: BREAKSINTHESIMULATION@GMAIL.COM",
          "color": "#a0a0a1",
          "email": "breaksinthesimulation@gmail.com",
          "note": "not a link on the live site"
        }
      ]
    },
